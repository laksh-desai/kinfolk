# --- Runtime ---
NODE_ENV=development             # development | test | production; production requires Google, S3 and SMTP settings

# --- Database ---
DATABASE_URL=                    # postgres://kinfolk:kinfolk@localhost:5432/kinfolk (docker compose up -d db)

# --- API ---
API_PORT=4000                    # PORT is honoured too, as hosts set it
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173    # used for CORS and for links in outbound email

# --- Sessions ---
SESSION_SECRET=                  # 32+ random bytes; rotate invalidates all sessions
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=                # empty outside production = dev sign-in form through the same session code
GOOGLE_CLIENT_SECRET=

# --- Google Places (address autocomplete; optional, app degrades to free text) ---
VITE_GOOGLE_PLACES_KEY=

# --- Object storage (photos, exports) ---
S3_ENDPOINT=                     # empty outside production = local filesystem storage
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=./var/storage  # filesystem storage root, used when S3_ENDPOINT is empty
LOCAL_STORAGE_PERSISTENT=false   # true = LOCAL_STORAGE_DIR is a disk that outlives deploys, so production needs no S3 (ADR 044)

# --- Outbound email (invites, OTP, review notifications) ---
SMTP_URL=                        # empty outside production = messages written to MAIL_OUTBOX_DIR
MAIL_FROM=                       # "Kinfolk <no-reply@example.com>"
MAIL_OUTBOX_DIR=./var/mail       # file outbox, used when SMTP_URL is empty

# --- Deployment ---
ALLOW_DEV_ADAPTERS=false         # true only for a preview: disk uploads and a file mail outbox, loudly (ADR 036)
SIGNUP_ALLOWLIST=                # addresses and @domains that may sign up; empty means anyone
RECORDS_PASSPHRASE=              # when set, public-record PDFs ask for it (ADR 037); never the demo password
SEED_EMAIL=                      # the account `pnpm db:seed` creates
SEED_PASSWORD=
