{
  "name": "kinfolk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Family tree intake and record-keeping for financial advisors, trustees, and estate planners.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:unit": "vitest run packages/shared",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint . && tsc -b --noEmit",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:seed": "pnpm --filter api exec tsx prisma/seed.ts",
    "db:reset": "pnpm --filter api exec prisma migrate reset --force"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}
